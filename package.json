  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update": "eas update",
    "test": "node --test \"scripts/release/*.test.mjs\" \"src/**/*.test.mjs\"",
    "test:jest": "jest",
    "build:tag": "scripts/release/build.sh",
    "release:verify": "node scripts/release/verify-pins.mjs",
    "build:internal": "eas build --profile internal --platform all",
    "build:internal:ios": "eas build --profile internal --platform ios",
    "build:internal:android": "eas build --profile internal --platform android",
    "build:beta": "eas build --profile beta --platform all",
    "build:beta:ios": "eas build --profile beta --platform ios",
    "build:beta:android": "eas build --profile beta --platform android",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "lint:fix": "oxlint --type-aware --fix"
  },
