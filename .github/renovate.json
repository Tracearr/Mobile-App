{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // House style (schedule, cooldowns, automerge, commit format, Actions) lives in the
  // shared preset. Only mobile-specific rules belong here.
  //
  // These rules are evaluated after the preset's, so a group declared here wins over a
  // broader group there. Two things depend on that: @types/react leaves the preset's
  // "type definitions" group and rides with Expo, and the Expo group's automerge:false
  // overrides the preset's blanket devDependency automerge.
  "extends": ["github>Tracearr/renovate-config"],

  "postUpdateOptions": ["pnpmDedupe"],

  "packageRules": [
    // pnpm-workspace.yaml only holds deliberate pins (the lightningcss override
    // react-native-css 3.0.7 needs). Nothing in there wants a bump PR.
    {
      "matchFileNames": ["pnpm-workspace.yaml"],
      "enabled": false
    },

    // @tracearr/shared and @tracearr/translations are published from the server
    // repo, version-locked to its release tag. Bump them together, on purpose.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tracearr/shared", "@tracearr/translations"],
      "groupName": "Tracearr packages",
      "automerge": false,
      "labels": ["dep-tracearr"]
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/*",
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "postcss"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Tailwind",
      "labels": ["dep-ui"]
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["i18next", "i18next-*", "react-i18next"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "i18n"
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tanstack/react-query", "zustand", "socket.io-client", "axios"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Data and state"
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "TypeScript tooling"
    },

    // ----- Expo and React Native -----
    // After the preset's automerge rules on purpose: later rules win, and the Expo SDK
    // controls too many transitive pins to trust automerge for anything in this group.
    // react and @types/react ride with the SDK, so they belong here too.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "babel-preset-expo",
        "react",
        "@types/react",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "@react-native-*/*",
        "@react-navigation/*",
        "@gorhom/bottom-sheet",
        "@shopify/react-native-skia",
        "nativewind",
        "victory-native",
        "lucide-react-native"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Expo and React Native",
      "automerge": false
    },

    // Gate Expo SDK majors behind dashboard approval. @babel/* rides along:
    // Expo 57 pins @babel/core 7 and babel-preset-expo is built against it.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "babel-preset-expo",
        "@babel/*",
        "react",
        "@types/react",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "@react-native-*/*",
        "@react-navigation/*"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },

    // Everything the Expo SDK pins in bundledNativeModules moves when the SDK
    // moves, not before. Both drift routes off SDK 57's matrix showed up here:
    // react-native 0.86.2 -> 0.87.0 arrived as a minor, because 0.x minors are
    // breaking but the major gate above does not see them, and skia rode a caret
    // five minors past the pinned 2.6.2. Gating minors closes both.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",
        "@react-native-async-storage/async-storage",
        "@shopify/react-native-skia"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },

    // Native modules: rebuild risk, review majors by hand.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@shopify/react-native-skia",
        "react-native-quick-crypto",
        "react-native-nitro-modules"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "description": "Native modules: rebuild risk, review by hand"
    }
  ]
}
