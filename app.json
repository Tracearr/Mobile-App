{
  "expo": {
    "name": "Tracearr",
    "slug": "tracearr",
    "platforms": ["ios", "android"],
    "version": "1.5.0",
    "icon": "./assets/icon.png",
    "scheme": "tracearr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "icon": "./assets/ios-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.tracearr.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "fetch"],
        "NSCameraUsageDescription": "Tracearr needs camera access to scan QR codes for server pairing.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Tracearr needs local network access to connect to your self-hosted server."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-transparent.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#051723"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.tracearr.mobile",
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "37.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "pickFirst": ["**/libcrypto.so"]
            }
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/withWidgetDrawables",
      [
        "./plugins/withGradleProperties",
        {
          "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=1g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8",
          "org.gradle.daemon": "false",
          "expo.camera.document-scanner-enabled": "false"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#18D1E7",
          "defaultChannel": "violations",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tracearr to access your camera for QR code scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      "react-native-quick-crypto",
      "expo-localization",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/splash-icon-transparent.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Inter_500Medium.ttf"]
        }
      ],
      "posthog-react-native/expo",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "bundleIdentifier": "com.tracearr.app.widgets",
          "groupIdentifier": "group.com.tracearr.app",
          "widgets": [
            {
              "name": "NowPlaying",
              "displayName": "Now Playing",
              "description": "Active streams and transcodes on your media servers.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./widgets/NowPlayingWidget.tsx",
                "configuration": {
                  "title": "Now Playing",
                  "description": "Choose what each stream shows.",
                  "parameters": {
                    "showUser": { "title": "User", "type": "boolean", "default": true },
                    "showEpisode": { "title": "Episode", "type": "boolean", "default": false },
                    "showQuality": {
                      "title": "Quality and Bitrate",
                      "type": "boolean",
                      "default": false
                    },
                    "showPlayer": { "title": "Player", "type": "boolean", "default": false },
                    "showProgress": { "title": "Progress", "type": "boolean", "default": false }
                  }
                }
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "initialLayout": "./widgets/NowPlayingWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2e0b9595-ac62-493f-9a10-4f8758bb4b2d"
      }
    },
    "owner": "gallopo-solutions",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2e0b9595-ac62-493f-9a10-4f8758bb4b2d",
      "enableBsdiffPatchSupport": true
    }
  }
}
