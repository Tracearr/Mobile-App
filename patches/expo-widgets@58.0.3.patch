+// Glance only offers defaultWeight(), an equal share that exists in Row and Column scope, so the
+// weight modifier leaves this marker and the parent swaps it for its own expand dimension.
+private object WeightMarker : GlanceModifier.Element
+
+private fun List<Emittable>.resolveWeight(expand: GlanceModifier.Element): List<Emittable> = onEach { child ->
+  if (child.modifier.any { it === WeightMarker }) {
+    child.modifier = child.modifier.foldIn<GlanceModifier>(GlanceModifier) { result, element ->
+      result.then(if (element === WeightMarker) expand else element)
+    }
   }
 }
 
